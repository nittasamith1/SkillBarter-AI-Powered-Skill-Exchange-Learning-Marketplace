# ============================================================
# SkillBarter AI — .gitignore
# ============================================================

# ── Secrets & Environment ──────────────────────────────────
.env
.env.local
.env.production
*.env

# ── Java / Maven ───────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
hs_err_pid*
replay_pid*

# ── Spring Boot ────────────────────────────────────────────
application-local.yml
application-secrets.yml
BOOT-INF/

# ── Node / npm ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Frontend build ─────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── IDE ────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/settings.json
.eclipse/
.settings/
.classpath
.project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ─────────────────────────────────────────────────
.docker/
docker-data/

# ── Logs ───────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── Test / Coverage ────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
surefire-reports/
